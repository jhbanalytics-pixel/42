page-*.png
*-snapshot.png

# Backup files
*.bak
*.bak-*

# Email files (meeting notes saved locally)
*.eml
*.msg

# Prior implementation reference (local only, 510MB)
trends-mvp/

# Allow reference materials tracked in docs/reference/
!docs/reference/
!docs/reference/**

# Internal comms and review docs — kept offline, never pushed
docs/reviews/
logs/

# Generated decks (PPTX builds + QA slide images)
deck/

# qlty cache + scan results (keep config + own gitignore tracked, not run state)
.qlty/cache/
.qlty/out/
.qlty/results/
.qlty/sources/

# Local QA screenshots (long mobile captures, not for repo)
qa-*.png
qa-*.jpg

# Reference materials from stakeholders (PDF mocks, briefs, decks).
# Keep local for context; never ship to the repo.
*.pdf
*.pptx
!deck/data-approach.pptx


# Vendor docs research artifacts (one-off probes, not for repo)
ed_openapi.json
dump_endpoints.py

# sources.yaml backups from progressive ship cycles (local rollback only)
configs/sources.yaml.pre-*-backup


# Windows-only debug + recovery scripts (local tooling, never ship)
fix-playwright-mcp.cmd
fix-playwright-mcp.ps1

# One-off audit reports (kept locally, not for repo)
BRAND24_YIELD_REPORT_*.txt

# Carla roadmap xlsx generator (offline-comms, gitignored per offline-comms rule)
scripts/build_carla_roadmap_xlsx.py
# Archived one-off doc generators (unused, not referenced anywhere in the repo).
# Untracked because the proposal generator embeds a past security-incident note
# in its output; keep it off the remote. Files stay on disk for local reference.
scripts/archive/
# Embedding classifier content-hash cache (local, regenerated)
data/embedding_cache.json

# Internal build-input + scoping material, never client-facing
docs/reference/
REQUIREMENTS_CHECKLIST.md
docs/PHASE_1_ACCEPTANCE.md
docs/PHASE_2_READINESS.md
