# Cron feature flags, single source of truth (no secrets in this file).
#
# The GCP deploy (cloudbuild.yaml) reads this one file and applies it to every
# Cloud Run job: the cron job (trends-engine-pipeline) plus the ops jobs
# (trends-engine-phase2 / -regen / -resend). Cloud Scheduler runs the cron job
# at 00:30 UTC (primary) and 02:30 UTC (fallback). There is no GitHub execution
# path. Flip a flag here and it lands on every job in one reviewed change. A
# change here triggers a cron-image rebuild via the configs/ path filter, so the
# live jobs pick it up on the next deploy. Editing a value on a job with gcloud
# directly is clobbered on the next rebuild, so always flip here.
#
# Format: dotenv KEY=VALUE, one per line, no quotes, no spaces around the =.
# Comment (#) and blank lines are stripped before the gcloud call.

# D2 M4 embedding rescue. Live 29 May 2026 after the cloud gate validated the
# curated example-phrase anchors clean at the module defaults (threshold 0.65,
# margin 0.05). Spends ~$8/mo on text-multilingual-embedding-002 over the
# keyword-unclassified residual (content-hash cached). Set false to go dark.
EMBEDDING_CLASSIFIER_ENABLED=true

# PULSE v2 editorial mailer: the full dark-native editorial email inline.
# Set false to fall back to the v1 ops digest.
MAILER_V2_ENABLED=true

# Hosted full-read archive. When set, each PULSE send uploads the rich body to
# gs://<bucket>/pulse/<date>-<token>.html and the inbox gets the lean teaser
# linking to it, so a heavy busy-day digest (real data is ~140KB) never hits the
# Gmail 102KB inline clip. The bucket is provisioned public-read out of band and
# the cron SA (trends-v2-github) holds objectAdmin; the object name carries an
# unguessable token so the world-readable digest cannot be enumerated by date.
# Unset = the rich body ships inline and clips on busy days.
MAILER_ARCHIVE_BUCKET=ogilvy-pulse-archive-k7m3xq

# Layer 2 ARIMA_PLUS 7-day forecast OUTLOOK chip. Off since 7 Jun 2026: a
# 3-week backtest lost to a naive "today holds" baseline, so the chip stays
# suppressed until the boosted-tree replacement ships. Non-fatal either way.
FORECAST_ENABLED=false

# Comment-sentiment "room" card. Live 8 Jun 2026 (real-data shadow validate,
# 14/24 lit, clean), one half of the Conversation Intelligence launch.
COMMENT_SENTIMENT_ENABLED=true

# Driving-hashtags "conversation" slot, paired under the room card. Live
# 8 Jun 2026 (per-tag Gemini moods, 23/24 lit, clean, geo-safe).
DRIVING_HASHTAGS_ENABLED=true

# Gemini 3.5 Flash for Phase-2 briefs + daily_summary. 3.5-flash is
# global-endpoint-only on Vertex, so GEMINI_LOCATION pins the brief client to
# global while the embedding classifier stays on us-central1 (code default).
# Revert both lines to fall back to gemini-2.5-flash (us-central1), no code change.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=global

# Dark language guard in topic_classifier.py. Default off; this is its durable
# home so a future live flip survives the next deploy. Set true to enable.
LANGUAGE_GUARD_ENABLED=false

# Topic-dominance arbitration in topic_classifier.py Layer 2. Default off. When
# true, a multi-keyword post is scored per family by hit count and only the
# strongest family (plus any within one hit) is kept, so an amapiano clip with
# one stray political word stops tagging politics. ~6% of tagged rows are
# multi-tagged. Shadow-validate against live enriched_content before flipping.
TOPIC_DOMINANCE_ENABLED=true

# Search-velocity signal in enrichment. Live 15 Jun 2026 (Jo-approved revive);
# the log-scale fix spreads the score instead of clipping ~80% of rising terms
# to 1.0. KE stays 0 (no public dataset coverage, ADR-0003). Weight 0.05.
# Set false to go dark.
SEARCH_VELOCITY_ENABLED=true

# Watchlist signal revive (15 Jun 2026). A: IG numeric-id handle fix so creators
# match the watchlist. B: per-topic watchlist score is the best creator match
# (max), not the diluting mean. C: creator /user/posts fire first at tier_1 to
# collect content by watchlisted creators (~400 units, under the 5000/day Bronze
# cap). Set any line false to go dark.
WATCHLIST_HANDLE_FIX=true
WATCHLIST_MAX_AGG=true
CREATOR_INGEST_BOOST=true

# Wave 1 + 2 additive display + instrumentation. Flipped 20 Jun 2026 after the
# dark ship merged clean (CI green on 3.11 + 3.13) and the OFF path was proven
# byte-identical by unit tests. All five are additive: badges, an email section,
# a stored sentiment score, and diagnostics. NONE change the trend_score
# composite or the Gemini brief prompt. Set any line false to go dark.
#
# Lifecycle phase badge (birth/growth/maturity/decline) from the velocity
# trajectory; stored on trend_scores, rendered on the brief.
LIFECYCLE_ENABLED=true
# Continuity badge (new / day 2 / day 3+ / rebounding) from a prior-day lookup.
CONTINUITY_BADGES_ENABLED=true
# Per-row winning classifier layer + per-layer counts + labelling_rate_percent
# into pipeline_runs (diagnostics, surfaced in engine_pulse). Invisible to
# stakeholders.
CLASSIFICATION_INSTRUMENTATION_ENABLED=true
# Platform heat-map section in the PULSE email (which platform drove the day),
# aggregated from the per-brief platform_counts.
PLATFORM_HEATMAP_ENABLED=true
# Social sentiment lexicon: scores social rows into
# enriched_content.sentiment_lexicon_score, the source the tone-split render bins.
SENTIMENT_LEXICON_ENABLED=true
# Tone-split section in the PULSE email: the day's positive / neutral / negative
# share. The tone_lexicon stage rolls the per-row lexicon scores into a per-brief
# list and tags the briefs (wired 21 Jun 2026); the section self-hides when a day
# has no scored rows. Live 21 Jun 2026.
TONE_SPLIT_ENABLED=true
# Pan-African section in the PULSE email: stories rising in 2+ SSA markets at
# once. The stage writes pan_african_stories during the run and render_html
# reads them back (wired 21 Jun 2026); the section self-hides on a single-market
# day. Live 21 Jun 2026.
PAN_AFRICAN_ENABLED=true

# PULSE Intelligence Core reconcile SHADOW. RE-ENABLED 2026-07-01 (PR #218)
# after the 2026-06-28 cost-control pause; first ON in shadow 2026-06-27.
# When ON in shadow the
# event-state ledger builds and the claim reconciler runs each cron, persisting
# the audit trail to event_ledger + reconcile_actions, but rendering NOTHING
# (RECONCILE_RENDER is unread, so no reader-facing output changes). The 3 tables
# are applied. Review scripts/reconcile_shadow_digest.py daily; promote to Phase
# 1 (labels) only after the observation criteria in
# docs/intel-core-activation-runbook.md. Flip back to false to go dark.
RECONCILE_ENABLED=true

# V3 Discovery Loop (Track A). Dark until flip-readiness gate passes.
SEED_GRAPH_ENABLED=true
NEAR_MISS_CAPTURE_ENABLED=true
SEED_PATH_RENDER_ENABLED=true
SEED_CANDIDATES_ENABLED=true
SEED_BEHAVIOUR_EMAIL_ENABLED=false

# Trust B1: persist corroboration family counts (dark until flip).
CORROB_COUNTS_ENABLED=false

# B0b scoped recovery override (empty default; per-execution only, NOT in _DURABLE_FLAGS).
FORCE_REINGEST_MARKETS=
