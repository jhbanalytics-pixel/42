# ============================================
# Trends Engine V2 — Environment Variables
# ============================================
# Copy to .env and fill in values. In production these live in GCP Secret
# Manager and are mounted as env on the Cloud Run job. The full daily-run
# flag set (28 flags) lives in configs/cron_flags.env, not here; this file
# is the local-dev + onboarding contract.

# Environment
TRENDS_ENV=dev  # dev | staging | prod. get_dataset() appends _{TRENDS_ENV} unless prod.

# GCP
GCP_PROJECT=
BIGQUERY_DATASET=trends_v2
VERTEX_LOCATION=us-central1
GEMINI_MODEL=           # gemini-3.5-flash in prod; gemini-2.5-flash is the fallback
GEMINI_LOCATION=global  # 3.x is global-only on Vertex; us-central1 404s for 3.x

# Data source APIs (secrets)
YOUTUBE_API_KEY=
ENSEMBLEDATA_API_TOKEN=    # Bronze tier, 5000 units/day. Token from ensembledata.com dashboard.
BRAND24_API_KEY=          # Business tier. X-Api-Key header. Project ids per market in configs/sources.yaml.
CLOUDFLARE_RADAR_TOKEN=   # Cloudflare Radar ranking connector
SOCIALCRAWL_API_KEY=      # SocialCrawl unfunded lane (jhb_core). This account holds no credits; staging refuses this lane.
SOCIALCRAWL_OGILVY_API_KEY=  # SocialCrawl funded account, read at version 1: the governed lane (SOCIALCRAWL_CREDENTIAL_LANE=ogilvy_funded) reads it. scripts/socialcrawl_rollout.py reads its balance with the funded ledger and holds a ladder not declared for that lane.
PULSAR_API_TOKEN=         # Pulsar read-only social-listening connector
SEMRUSH_API_KEY=          # SEMrush connector (held dark)
AUDIOMACK_CONSUMER_KEY=   # Audiomack chart connector
AUDIOMACK_CONSUMER_SECRET=

# Gmail SMTP for the daily PULSE digest
# Requires a Google app password (2FA on the sender account).
# Create one at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_RECIPIENTS=           # comma-separated, e.g. a@x.com,b@y.com
EMAIL_ALERTS_ENABLED=false  # 'true' to actually send mail

# Feature flags (true in prod)
PHASE_2_ENABLED=true              # Vertex Gemini brief layer
EMBEDDING_CLASSIFIER_ENABLED=true # M4 multilingual-embedding rescue
MAILER_V2_ENABLED=true            # PULSE editorial mailer (v3 render)

# Dark flags (default false; plumbed end-to-end, not yet flipped live)
SEARCH_VELOCITY_ENABLED=false
LANGUAGE_GUARD_ENABLED=false

# Optional
MAILER_ARCHIVE_BUCKET=  # GCS bucket for the hosted full-read link; inert when unset.
                        # Bucket must already grant allUsers:objectViewer, see DEVELOPMENT.md.
