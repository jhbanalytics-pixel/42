# Staging engine image. This packages runtime code and contains no deployment recipe.
FROM --platform=linux/amd64 python:3.13-slim@sha256:16f75ad0fbc6c4883a8afd63b2d700c3cf68ccffc1aaeca5304ca0a3a908451f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.lock ./
RUN pip install --require-hashes -r requirements.lock

COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
COPY scripts/ ./scripts/
RUN pip install --no-deps . --no-build-isolation && \
    python -c "from scripts.staging.run_live_intelligence_brain import _write_runtime_inventory; _write_runtime_inventory()" && \
    chmod 0444 /app/runtime-distributions.json /app/runtime-distributions.sha256

COPY configs/ ./configs/
COPY infra/ ./infra/
COPY ops/ ./ops/
COPY ops-source-inventory.txt ./
COPY cloudbuild.staging.yaml ./
COPY docs/contracts/open_intelligence_v2.md ./docs/contracts/

RUN useradd --create-home --uid 10001 appuser && \
    mkdir -p /app/data && \
    chown appuser:appuser /app/data
USER appuser

ENTRYPOINT ["python"]
CMD ["-c", "raise SystemExit('An explicit reviewed staging command is required')"]
