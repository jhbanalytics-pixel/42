# Cloud Run definitions of f42-agent and f42-api, sourced by bash in core/api/deploy.sh (from the PC) and in
# .github/workflows/staging-app.yml (from GitHub Actions), so both deploy the services the same way.
# The caller sets PROJECT and TAG before sourcing, and appends AGENT_URL to API_ENV once f42-agent is up.

# f42-agent: private, one instance holding running asks, CPU always on so an
# ask keeps running after its 202, and long requests for SSE and wait=true.
# One instance stays warm (--min-instances 1): from cold a live Ask took over
# 10 minutes, warm about 4. That instance is billed all the time, CPU included.
# Ask is pinned to Gemini 3.8 Flash on Vertex, the only model provider.
# F42_T2_READY=1 opens T2 on /api/ask for the brand lens and the context pack only (core/api/agent_app.py t2_ready);
# a T2 ask reserves its whole model hold under MODEL_DAILY_USD before it starts (else it runs at T0), and each live
# call is held to the question's 300 credits and to ASK_DAILY by the SocialCrawl client. Drop it to close T2 again.
AGENT_SA="f42-agent"
AGENT_FLAGS="--no-allow-unauthenticated --min-instances 1 --max-instances 1 --no-cpu-throttling --timeout 3600 --memory 1Gi"
AGENT_ENV="APP_MODULE=core.api.agent_app:app,F42_DATA=bigquery,F42_PROJECT=${PROJECT},F42_VERSION=${TAG},MODEL_PROVIDER=gemini,GEMINI_MODEL=gemini-3.8-flash,F42_T2_READY=1"
AGENT_SECRETS="SOCIALCRAWL_OGILVY_API_KEY=SOCIALCRAWL_OGILVY_API_KEY:latest"

# f42-api: the app, the passcode gate and the Ask proxy. Stateless. The passcode
# is the gate until IAP, so the invoker IAM check is off; no IAM binding is added.
# One instance stays warm (--min-instances 1, demo week from 4 October 2026) so the
# first page load does not wait for a cold start. CPU is throttled between requests.
API_SA="f42-web"
API_FLAGS="--no-invoker-iam-check --min-instances 1 --max-instances 3 --timeout 3600"
API_ENV="APP_MODULE=core.api.app:app,F42_DATA=bigquery,F42_PROJECT=${PROJECT},F42_VERSION=${TAG}"
API_SECRETS="UI_PASSCODE=UI_PASSCODE:latest"
